from sklearn.preprocessing import StandardScaler
from sklearn.cluster import AgglomerativeClustering
from sklearn.metrics import silhouette_score
from scipy.cluster.hierarchy import dendrogram, linkage
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.decomposition import PCA

# Standardize
scaler = StandardScaler()
X_scaled = scaler.fit_transform(df_counties[feature_cols])

# Silhouette scores to confirm k
silhouette_scores_list = []
K_range = range(2, 9)
for k in K_range:
    model = AgglomerativeClustering(n_clusters=k, linkage='ward')
    labels = model.fit_predict(X_scaled)
    silhouette_scores_list.append(silhouette_score(X_scaled, labels))

print("Silhouette scores:")
for k, s in zip(K_range, silhouette_scores_list):
    print(f"  k={k}: {s:.4f}")

# Dendrogram
Z = linkage(X_scaled, method='ward')
fig, ax = plt.subplots(figsize=(14, 5))
dendrogram(Z, truncate_mode='lastp', p=30, leaf_rotation=45, leaf_font_size=9, ax=ax, color_threshold=22)
ax.axhline(y=22, color='tomato', linestyle='--', linewidth=1.5, label='Cut → k=4')
ax.set_title('Dendrogram — County Health Profiles (Ward Linkage, Last 30 Merges)')
ax.set_ylabel('Merge Distance')
ax.legend()
plt.tight_layout()
plt.savefig('dendrogram.png', dpi=150)

# Fit final model
model = AgglomerativeClustering(n_clusters=4, linkage='ward')
df_counties['cluster'] = model.fit_predict(X_scaled)

# Cluster summary
cluster_summary = df_counties.groupby('cluster')[feature_cols].mean().round(4)
print("\nCluster means:")
print(cluster_summary.to_string())

# Cluster sizes
print("\nCluster sizes:")
print(df_counties['cluster'].value_counts().sort_index())

# Sample counties per cluster
for c in range(4):
    sample = df_counties[df_counties['cluster'] == c][['county', 'state']].head(5)
    print(f"\nCluster {c} samples:")
    print(sample.to_string(index=False))
